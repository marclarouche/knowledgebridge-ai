  "answers": [
    {
      "id": "RQ-009",
      "category": "paraphrase",
      "question": "How can an administrator require a second factor when signing in?",
      "expected_status": "answered",
      "status": "answered",
      "status_matches": true,
      "answer_digest": "a22ac33fdfd5e1766a3ab9587435ad987d1608e40e1d028ad4a6a073bdc13429",
      "citations": 1,
      "valid_citations": 1,
      "missing_evidence_references": 0,
      "answer": {
        "schema_version": "1.0",
        "answer_id": "9dec9b13-74c8-4370-9f2b-7949bb920d2c",
        "status": "answered",
        "text": "To require a second factor when signing in, an administrator must set require_mfa=true in the Administration > Security > Authentication section of FleetOps 2.0.",
        "claims": [
          {
            "schema_version": "1.0",
            "text": "To require a second factor when signing in, an administrator must set require_mfa=true in the Administration > Security > Authentication section of FleetOps 2.0.",
            "evidence": [
              {
                "schema_version": "1.0",
                "passage_id": "ac677804-7d50-5148-975f-e9b2f650a18f",
                "quote": "For FleetOps 2.0, open Administration > Security > Authentication and set require_mfa=true. New administrator sessions must complete the configured second-factor enrollment."
              }
            ]
          }
        ],
        "conflicts": [],
        "citations": [
          {
            "schema_version": "1.0",
            "passage": {
              "schema_version": "1.0",
              "passage_id": "ac677804-7d50-5148-975f-e9b2f650a18f",
              "text": "## Multi-factor authentication\n\nFor FleetOps 2.0, open Administration > Security > Authentication and set require_mfa=true. New administrator sessions must complete the configured second-factor enrollment. Existing active sessions keep their original expiry until revoked. The sample does not establish recovery-code regeneration behavior.\n\n",
              "location": {
                "schema_version": "1.0",
